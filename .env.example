# Host and port the ALIEN X & Coach Go server listens on
ALIENX_HOST=0.0.0.0
ALIENX_PORT=8787

# Shared bearer token (at least 32 characters). Generate via:
# npm run alienx:setup  (or `go -C axosbackend run ./cmd/setup`)
ALIENX_SERVER_TOKEN=

# AI & Voice Provider Keys (server-only, never put these in the mobile app)
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
SARVAM_API_KEY=

# Optional model overrides
GEMINI_MODEL=gemini-3.1-flash-lite
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_REASONER_MODEL=deepseek-reasoner
SARVAM_CHAT_MODEL=sarvam-m
SARVAM_STT_MODEL=saaras:v4
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_SPEAKER=gokul

# Optional exact browser origin for CORS
# ALIENX_WEB_ORIGIN=http://localhost:8081
